-- AlgoViz Code Execution Database Schema

CREATE DATABASE IF NOT EXISTS algoviz_code_execution;
USE algoviz_code_execution;

-- Problems table
CREATE TABLE problems (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    scenario TEXT,
    input_format TEXT,
    output_format TEXT,
    hints TEXT,
    difficulty ENUM('EASY', 'MEDIUM', 'HARD') NOT NULL DEFAULT 'EASY',
    category VARCHAR(100),
    time_limit INT DEFAULT 2000, -- milliseconds
    memory_limit INT DEFAULT 128, -- MB
    max_score INT DEFAULT 100,
    xp_reward INT DEFAULT 50,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX idx_difficulty (difficulty),
    INDEX idx_category (category)
);

-- Test cases table
CREATE TABLE test_cases (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    problem_id BIGINT NOT NULL,
    test_number INT NOT NULL,
    input TEXT,
    expected_output TEXT,
    is_sample BOOLEAN DEFAULT FALSE,
    explanation VARCHAR(500),
    time_limit INT, -- Override problem time limit if needed
    memory_limit INT, -- Override problem memory limit if needed
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (problem_id) REFERENCES problems(id) ON DELETE CASCADE,
    INDEX idx_problem_test (problem_id, test_number),
    INDEX idx_sample (is_sample)
);

-- Starter codes table
CREATE TABLE starter_codes (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    problem_id BIGINT NOT NULL,
    language VARCHAR(20) NOT NULL,
    code TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (problem_id) REFERENCES problems(id) ON DELETE CASCADE,
    UNIQUE KEY unique_problem_language (problem_id, language),
    INDEX idx_language (language)
);

-- Submissions table
CREATE TABLE submissions (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    problem_id BIGINT NOT NULL,
    language VARCHAR(20) NOT NULL,
    code TEXT NOT NULL,
    verdict ENUM('ACCEPTED', 'WRONG_ANSWER', 'TIME_LIMIT_EXCEEDED', 'MEMORY_LIMIT_EXCEEDED', 
                 'RUNTIME_ERROR', 'COMPILATION_ERROR', 'PRESENTATION_ERROR', 'INTERNAL_ERROR') NOT NULL,
    score INT DEFAULT 0,
    execution_time BIGINT, -- milliseconds
    memory_used BIGINT, -- bytes
    passed_tests INT DEFAULT 0,
    total_tests INT DEFAULT 0,
    error TEXT,
    submitted_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (problem_id) REFERENCES problems(id) ON DELETE CASCADE,
    INDEX idx_user_problem (user_id, problem_id),
    INDEX idx_user_submitted (user_id, submitted_at),
    INDEX idx_problem_submitted (problem_id, submitted_at),
    INDEX idx_verdict (verdict),
    INDEX idx_submitted_at (submitted_at)
);

